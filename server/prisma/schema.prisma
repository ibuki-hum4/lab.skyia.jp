// スキーマの正は prisma/migrations/*/migration.sql。ここはクライアントの型を作るための写し。
// モデル名と項目名は Better Auth の名前(user・session・account・verification、camelCase)にして、
// @@map と @map で DB のテーブル名と列名(snake_case)に付け替える。

generator client {
  // Prisma 7 の TypeScript の生成器。node_modules の外(src/generated)に作る。
  // server は bun build で 1 つのファイルにまとめるので、エンジンのバイナリを持たないこちらにする
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // 接続情報は prisma.config.ts(Prisma 7 から url はここに書けない)
  provider = "postgresql"
}

model user {
  id            String    @id
  /// @ のハンドル。初回のログインのあと /welcome で決めるので、それまでは null
  handle        String?
  /// 表示名(Better Auth の name)。初回のログインのときだけ HoshID から取り、あとは本人が /settings/profile で変える
  name          String    @default("") @map("display_name")
  bio           String    @default("")
  /// member / moderator / admin
  role          String    @default("member")
  suspendedAt   DateTime? @map("suspended_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  /// アイコン画像の中身のハッシュ(先頭 16 文字)。なければ null
  avatarHash    String?   @map("avatar_hash")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  accounts  account[]
  sessions  session[]
  following follow[]  @relation("follower")
  followers follow[]  @relation("followee")
  blocking  block[]   @relation("blocker")
  blockedBy block[]   @relation("blocked")

  avatar         userAvatar?
  notes          note[]        @relation("noteAuthor")
  hiddenNotes    note[]        @relation("noteHider")
  noteCounters   noteCounter[]
  comments       comment[]     @relation("commentAuthor")
  hiddenComments comment[]     @relation("commentHider")
  likes          noteLike[]

  @@map("users")
}

model account {
  id                    String    @id
  userId                String    @map("user_id")
  providerId            String    @map("provider_id")
  accountId             String    @map("account_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model session {
  id        String   @id
  token     String   @unique
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  /// 使うたびに Better Auth が延ばす(updatedAt)
  updatedAt DateTime @default(now()) @updatedAt @map("last_seen_at") @db.Timestamptz
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// /auth/login から /auth/callback までの間だけ持つもの(state のハッシュ、nonce・PKCE の verifier などの JSON)
model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([identifier])
  @@index([expiresAt])
  @@map("auth_flows")
}

model follow {
  followerId String   @map("follower_id")
  followeeId String   @map("followee_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  follower   user     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee   user     @relation("followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId])
  @@map("follows")
}

model block {
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  blocker   user     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   user     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}


/// アイコン画像。users に置くと Better Auth がリクエストのたびに読むので分けている
model userAvatar {
  userId      String   @id @map("user_id")
  contentType String   @map("content_type")
  data        Bytes
  hash        String
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz
  user        user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_avatars")
}

/// 実験・記事・メモ
model note {
  id           BigInt    @id @default(autoincrement())
  authorId     String    @map("author_id")
  /// experiment / article / memo
  kind         String
  /// 作者・種類ごとの通し番号
  number       Int
  title        String
  body         String    @default("")
  bodyHtml     String    @default("") @map("body_html")
  toc          Json      @default("[]")
  excerpt      String    @default("")
  draft        Boolean   @default(true)
  /// pass / fail / watch。実験だけ
  status       String?
  watchSince   DateTime? @map("watch_since") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  publishedAt  DateTime? @map("published_at") @db.Timestamptz
  hiddenAt     DateTime? @map("hidden_at") @db.Timestamptz
  hiddenBy     String?   @map("hidden_by")
  hiddenReason String?   @map("hidden_reason")

  author        user                @relation("noteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  hider         user?               @relation("noteHider", fields: [hiddenBy], references: [id], onDelete: SetNull)
  history       noteStatusHistory[]
  linksAsSource noteLink[]          @relation("linkSource")
  linkAsTarget  noteLink?           @relation("linkTarget")
  comments      comment[]
  tags          noteTag[]
  likes         noteLike[]

  @@unique([authorId, kind, number])
  @@index([publishedAt(sort: Desc), id(sort: Desc)])
  @@map("notes")
}

model noteCounter {
  authorId String @map("author_id")
  kind     String
  last     Int
  user     user   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([authorId, kind])
  @@map("note_counters")
}

model noteStatusHistory {
  id         BigInt   @id @default(autoincrement())
  noteId     BigInt   @map("note_id")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  changedAt  DateTime @default(now()) @map("changed_at") @db.Timestamptz
  note       note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, changedAt])
  @@map("note_status_history")
}

/// 追試(replication)と派生(derivation)
model noteLink {
  id        BigInt   @id @default(autoincrement())
  kind      String
  sourceId  BigInt   @map("source_id")
  targetId  BigInt   @unique @map("target_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  source    note     @relation("linkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target    note     @relation("linkTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([sourceId, kind])
  @@map("note_links")
}

model comment {
  id           BigInt    @id @default(autoincrement())
  noteId       BigInt    @map("note_id")
  authorId     String    @map("author_id")
  body         String
  bodyHtml     String    @default("") @map("body_html")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  hiddenAt     DateTime? @map("hidden_at") @db.Timestamptz
  hiddenBy     String?   @map("hidden_by")
  hiddenReason String?   @map("hidden_reason")
  note         note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  author       user      @relation("commentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  hider        user?     @relation("commentHider", fields: [hiddenBy], references: [id], onDelete: SetNull)

  @@index([noteId, createdAt, id])
  @@map("comments")
}

model tag {
  id    BigInt    @id @default(autoincrement())
  name  String    @unique
  notes noteTag[]

  @@map("tags")
}

model noteTag {
  noteId BigInt @map("note_id")
  tagId  BigInt @map("tag_id")
  note   note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
  @@map("note_tags")
}

model noteLike {
  userId    String   @map("user_id")
  noteId    BigInt   @map("note_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([userId, noteId])
  @@index([noteId])
  @@map("note_likes")
}
