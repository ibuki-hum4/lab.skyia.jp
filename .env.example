# 手元の開発用の設定。`cp .env.example .env` して使う(.env は Git に入らない)。
# 本番の値は deploy/configmap.yaml(秘密でないもの)と deploy/sealed-secret.yaml(秘密)にある。

# このサイトの URL。開発中はブラウザで開く Vite の URL
LAB_BASE_URL=http://localhost:5173

# PostgreSQL(`podman compose up -d` で立てたもの)
DATABASE_URL=postgresql://lab:lab@127.0.0.1:5432/lab

# Better Auth が Cookie の署名などに使う。`openssl rand -base64 32` などで作る
BETTER_AUTH_SECRET=

# アプリの手前のプロキシ(本番は Traefik の Pod の CIDR)。手元では空
TRUSTED_PROXIES=

# ---- HoshID(OIDC)----
# 手元ではニセの HoshID(`bun run dev:oidc`)を使う。本物につなぐときは、HoshID に登録した値にする
HOSHID_ISSUER=http://127.0.0.1:9999
HOSHID_CLIENT_ID=lab-dev
HOSHID_CLIENT_SECRET=lab-dev-secret
# 省略すると <LAB_BASE_URL>/auth/callback/hoshid
HOSHID_REDIRECT_URI=

# ロールが入るクレームの名前と、値 → ロール(member / moderator / admin)。クレームがなければ member
HOSHID_ROLES_CLAIM=roles
HOSHID_ROLE_MAP=一般:member,役員:moderator,管理者:admin
# 表示名とニックネームのクレームの名前
HOSHID_DISPLAY_NAME_CLAIM=name
HOSHID_NICKNAME_CLAIM=nickname

# テスト用の DB(`bun run test`)。compose が lab_test を作る
TEST_DATABASE_URL=postgresql://lab:lab@127.0.0.1:5432/lab_test
